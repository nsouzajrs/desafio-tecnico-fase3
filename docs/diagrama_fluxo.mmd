---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	intake(intake)
	load_patient(load_patient)
	check_pending_exams(check_pending_exams)
	retrieve_protocols(retrieve_protocols)
	draft_answer(draft_answer)
	safety_check(safety_check)
	fallback_answer(fallback_answer)
	finalize(finalize)
	emit_alerts(emit_alerts)
	__end__([<p>__end__</p>]):::last
	__start__ --> intake;
	check_pending_exams --> retrieve_protocols;
	draft_answer --> safety_check;
	fallback_answer --> finalize;
	finalize -. &nbsp;end&nbsp; .-> __end__;
	finalize -. &nbsp;alerts&nbsp; .-> emit_alerts;
	intake -. &nbsp;blocked&nbsp; .-> finalize;
	intake -. &nbsp;ok&nbsp; .-> load_patient;
	load_patient -. &nbsp;ok&nbsp; .-> check_pending_exams;
	load_patient -. &nbsp;missing&nbsp; .-> finalize;
	retrieve_protocols --> draft_answer;
	safety_check -. &nbsp;fallback&nbsp; .-> fallback_answer;
	safety_check -. &nbsp;ok&nbsp; .-> finalize;
	emit_alerts --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
