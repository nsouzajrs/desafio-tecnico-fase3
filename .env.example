# Copie para .env se quiser (o projeto lê variáveis de ambiente; no Colab use os "Secrets").

# Token do Hugging Face (necessário para baixar o Llama; crie em huggingface.co/settings/tokens)
HF_TOKEN=

# Modelo base (3B para o Colab gratuito; use o 1B para testes rápidos)
BASE_MODEL=meta-llama/Llama-3.2-3B-Instruct

# Onde está o adapter LoRA treinado (copie do Google Drive para cá)
ADAPTER_DIR=artifacts/adapter

# Opcionais
# AUDIT_LOG_PATH=logs/audit.jsonl
# DB_PATH=data/hospital.db
# OLLAMA_MODEL=llama3.2
